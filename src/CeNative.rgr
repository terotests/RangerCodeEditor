; ==============================================================================
; CeNative - text in the target's own units, for the Rust-syntax modules.
; ==============================================================================
;
; The lexers and the editor count offsets the way each target's strings do:
; UTF-16 units in JavaScript, bytes in Go, C++ and Rust. strlen, charAt and
; substring give exactly that; these are the same operators for the .rs
; modules. Rust's own `s.as_bytes()[i]` copies the whole string on every call
; on JavaScript and Go, which makes a lexer quadratic.
;
; Kept in .rgr because Ranger's Rust frontend has no spelling for these
; operators.

class CeNative {
    sfn str_len:int (s:string) {
        return (strlen s)
    }
    sfn char_at:int (s:string i:int) {
        return (charAt s i)
    }
    sfn substr:string (s:string a:int b:int) {
        return (substring s a b)
    }
    ; the one-character string of a code point
    sfn from_code:string (c:int) {
        return (strfromcode c)
    }
    sfn index_of:int (text:string key:string) {
        return (indexOf text key)
    }
    sfn index_of_from:int (text:string key:string from:int) {
        return (indexOfFrom text key from)
    }
    sfn last_index_of:int (text:string key:string) {
        return (lastIndexOf text key)
    }
}
